/**

 * @brief The application entry point.

 * @retval int

 */

int main(void)

{

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* MCU Configuration--------------------------------------------------------*/

	/* Reset of all peripherals, Initializes the Flash interface and the Systick. */

	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* Configure the system clock */

	SystemClock_Config();

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */

	MX_GPIO_Init();

	MX_USART1_UART_Init();

	MX_USART2_UART_Init();

	/* USER CODE BEGIN 2 */

	char *menu =
			"\r\n=== PUENTE GPS ===\r\nPresiona:\r\n1: 9600\r\n2: 38400\r\n3: 57600\r\n4: 115200\r\n";

	HAL_UART_Transmit(&huart2, (uint8_t*) menu, strlen(menu), 100);

// Iniciar la escucha del GPS (USART1) y de la PC (USART2)

	HAL_UART_Receive_IT(&huart1, &rx_data, 1);

	HAL_UART_Receive_IT(&huart2, &rx_pc, 1);

	/* USER CODE END 2 */

	/* Infinite loop */

	/* Infinite loop */

	/* USER CODE BEGIN WHILE */

	while (1) {
		// Si la cabeza es distinta a la cola, hay datos nuevos en el búfer circular
		if (rx_head != rx_tail) {
			// Tomar el byte más antiguo
			char incoming_byte = (char) rx_buffer[rx_tail];

			// Avanzar la cola
			rx_tail = (rx_tail + 1) % RX_BUF_SIZE;

			// Armar la trama NMEA
			if (incoming_byte != '\n' && incoming_byte != '\r') {
				// Evitar desbordamiento del búfer lineal
				if (line_index < (sizeof(nmea_line) - 1)) {
					nmea_line[line_index++] = incoming_byte;
				}
			} else if (incoming_byte == '\n') {
				// Terminó la línea. Cerramos el string.
				nmea_line[line_index] = '\0';

				if (line_index > 0) {
					// 1. Enviar al parser (él se encarga de ver si es $GPGGA, $GPGLL, etc.)
					nmea_parse(&gps_data, (uint8_t*) nmea_line);

					// 2. Verificar si tenemos fix (posición válida) para enviar a la PC
					if (gps_data.fix == 1) {
						char debug_msg[100];
						// Puedes extraer altitud, latitud, longitud, etc.
						sprintf(debug_msg,
								"[HAPS] Fix OK | Alt: %.2f m | Sats: %d\r\n",
								gps_data.msl_altitude, gps_data.satellites);
						HAL_UART_Transmit(&huart2, (uint8_t*) debug_msg,
								strlen(debug_msg), 50);
					}
				}
				// Reiniciamos el índice para la próxima trama
				line_index = 0;
			}
		}
		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */

	}

	/* USER CODE END 3 */

}

