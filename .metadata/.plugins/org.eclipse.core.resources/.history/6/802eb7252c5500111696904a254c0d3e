/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();

  // 1. ESPERA DE TERMINAL
  for(int i=0; i<3; i++) {
      char *msg = "Esperando terminal...\r\n";
      HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), 100);
      Delay_ms(500); // Usamos nuestra función segura
  }

  UART_Print("\r\n--- INICIALIZANDO HARDWARE ---\r\n");

  // 2. INICIALIZACIÓN I2C Y BMI270
  MX_I2C3_Init();
  uint8_t chip_id = BMI270_ReadReg(REG_CHIP_ID);

  if(chip_id == 0x24) {
        UART_Print("1. CHIP_ID OK. Preparando IMU...\r\n");

        // 1. Soft Reset: Obligatorio según Bosch antes de cargar el microcódigo
        BMI270_WriteReg(0x7E, 0xB6);
        Delay_ms(50); // Le damos tiempo al sensor para reiniciar su memoria

        BMI270_WriteReg(REG_PWR_CONF, 0x00);  Delay_ms(1);
        BMI270_WriteReg(REG_INIT_CTRL, 0x00); Delay_ms(1);

        UART_Print("   -> Cargando archivo de configuracion (8KB)...\r\n");
        BMI270_LoadConfigFile();
              UART_Print("2. Configuracion de BMI270 enviada.\r\n");

              // Disparamos la inicialización del microcódigo
              BMI270_WriteReg(REG_INIT_CTRL, 0x01);

              UART_Print("   -> Esperando estabilizacion del ASIC...\r\n");
              // Damos 300ms reales, el doble de lo que pide Bosch por seguridad
              Delay_ms(300);

              // Bucle de sondeo: esperamos hasta que esté listo o pasen 10 intentos
              uint8_t init_status = 0;
              for (int t = 0; t < 10; t++) {
                  init_status = BMI270_ReadReg(REG_INTERNAL_STATUS);
                  if (init_status == 0x01) {
                      break; // ¡Exito!
                  }
                  Delay_ms(50); // Si no está listo, esperamos un poco más
              }

              char st_msg[60];
              snprintf(st_msg, sizeof(st_msg), "   -> INTERNAL_STATUS: 0x%02X\r\n", init_status);
              UART_Print(st_msg);

              if (init_status == 0x01) {
                  UART_Print("   -> ¡Microcodigo Aceptado!\r\n");
              } else {
                  UART_Print("   -> [ERROR] El ASIC sigue rechazando la configuracion.\r\n");
              }
        // 3. Encender específicamente Acelerómetro y Temperatura en PWR_CTRL (0x7D)
        // 0x0E = 0b00001110 (Temp=1, Acc=1, Gyr=1, Aux=0)
        BMI270_WriteReg(REG_PWR_CTRL,  0x0E); Delay_ms(1);

        // 4. Salir del modo de ahorro de energía en PWR_CONF (0x7C)
        BMI270_WriteReg(REG_PWR_CONF,  0x02); Delay_ms(2);

        // Configuraciones de rango
        BMI270_WriteReg(REG_ACC_CONF,  0xA8); Delay_ms(1);
        BMI270_WriteReg(REG_ACC_RANGE, 0x02); Delay_ms(1);

        BMI270_WriteReg(0x42, 0xA9);          Delay_ms(1);
        BMI270_WriteReg(0x43, 0x00);          Delay_ms(1);
    }

  // 3. INICIALIZACIÓN RTC Y LORA
  UART_Print("3. Inicializando RTC...\r\n");
  MX_RTC_Init();
  UART_Print("4. RTC OK.\r\n");

  UART_Print("5. Inicializando Radio LoRa...\r\n");
  MX_SubGHz_Phy_Init();
  UART_Print("6. Radio LoRa OK.\r\n");

  UART_Print("--- SISTEMA LISTO. INICIANDO TELEMETRÍA ---\r\n");

  // Habilitar recepción de GPS por interrupción
  HAL_UART_Receive_IT(&huart1, &rx_data, 1);

  // Variables de control de tiempo
  uint32_t loop_counter = 0;
  uint8_t gps_valid = 0;

  /* BUCLE PRINCIPAL */
  while (1)
  {
      // ¡CRÍTICO! Procesa el stack LoRa interno (si no, OnTxDone nunca se llama)
      MX_SubGHz_Phy_Process();

      uint8_t trigger_telemetry = 0;

      // ==========================================
      // TAREA 1: PROCESAR GPS (NMEA)
      // ==========================================
      if (rx_head != rx_tail)
      {
          char c = (char)rx_buffer[rx_tail];
          rx_tail = (rx_tail + 1) % RX_BUF_SIZE;

          if (c == '\n' || line_index >= sizeof(line_buffer) - 1)
          {
              line_buffer[line_index] = '\0';
              if (strstr(line_buffer, "GGA") != NULL)
              {
                  trigger_telemetry = 1;
                  gps_valid = 1;
                  loop_counter = 0; // Reiniciamos el contador watchdog
              }
              line_index = 0;
          }
          else if (c != '\r')
          {
              line_buffer[line_index++] = c;
          }
      }

      // ==========================================
      // TAREA 2: WATCHDOG (Transmite si no hay GPS)
      // ==========================================
      // Como HAL_GetTick() podría estar frenado, usamos iteraciones del bucle
      loop_counter++;
      if (loop_counter > 500000) // Ajustá este valor para cambiar la frecuencia de envío sin GPS
      {
          trigger_telemetry = 1;
          gps_valid = 0;
          loop_counter = 0;
      }

      // ==========================================
      // TAREA 3: ENSAMBLAR Y ENVIAR PAQUETE TLV
      // ==========================================
      if (trigger_telemetry == 1)
      {
          lora_tx_len = 0;

          // 1. Datos GPS (Si hay Fix)
          if (gps_valid)
          {
              char time_str[15]={0}, lat_str[15]={0}, ns[2]={0};
              char lon_str[15]={0}, ew[2]={0}, alt_str[10]={0}, fix_str[2]={0};

              get_nmea_field(line_buffer, 1, time_str);
              get_nmea_field(line_buffer, 2, lat_str);
              get_nmea_field(line_buffer, 3, ns);
              get_nmea_field(line_buffer, 4, lon_str);
              get_nmea_field(line_buffer, 5, ew);
              get_nmea_field(line_buffer, 6, fix_str);
              get_nmea_field(line_buffer, 9, alt_str);

              if (fix_str[0] >= '1') {
                  int utc_h = (time_str[0]-'0')*10 + (time_str[1]-'0');
                  int art_h = (utc_h - 3 < 0) ? utc_h - 3 + 24 : utc_h - 3;
                  uint8_t m = (time_str[2]-'0')*10 + (time_str[3]-'0');
                  uint8_t s = (time_str[4]-'0')*10 + (time_str[5]-'0');
                  tlv_pack_3bytes(0x01, (uint8_t)art_h, m, s);

                  int32_t lat_int = nmea_to_int32(lat_str, ns[0]);
                  int32_t lon_int = nmea_to_int32(lon_str, ew[0]);
                  tlv_pack_gps_coords(0x02, lat_int, lon_int);

                  int16_t alt_int = (int16_t)atof(alt_str);
                  tlv_pack_int16(0x03, alt_int);
              }
          }

          // 2. Datos IMU BMI270
          uint8_t raw[14];
          BMI270_ReadRegs(REG_DATA_8, raw, 14);
          int16_t acc_x = (int16_t)((raw[1] << 8) | raw[0]);
          int16_t acc_y = (int16_t)((raw[3] << 8) | raw[2]);
          int16_t acc_z = (int16_t)((raw[5] << 8) | raw[4]);
          float temp = BMI270_ReadTemperature();

          tlv_pack_accel(0x04, acc_x, acc_y, acc_z);
          int16_t temp_scaled = (int16_t)(temp * 100.0f);
          tlv_pack_int16(0x05, temp_scaled);

          // 3. Imprimir el paquete ensamblado por UART
          char debug_msg[250] = "\r\n--> TLV [";
          char hex_byte[5];
          for (int k = 0; k < lora_tx_len; k++) {
              snprintf(hex_byte, sizeof(hex_byte), "%02X ", lora_tx_buffer[k]);
              strcat(debug_msg, hex_byte);
          }
          char tail_buf[30];
          snprintf(tail_buf, sizeof(tail_buf), "] (%d bytes)\r\n", lora_tx_len);
          strcat(debug_msg, tail_buf);
          UART_Print(debug_msg);

          // 4. Disparar Transmisión LoRa
          LoRa_Transmit(lora_tx_buffer, lora_tx_len);
      }
  }
}

