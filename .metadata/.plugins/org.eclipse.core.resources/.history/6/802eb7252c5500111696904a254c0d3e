void LoRa_Transmit(uint8_t *payload, uint8_t size)
{
    radio_tx_done = 0;
    Radio.Standby();
    Radio.Send(payload, size);

    uint32_t t0 = HAL_GetTick();
    while (radio_tx_done == 0 && (HAL_GetTick() - t0 < 2000))
    {
        // FIX: llamar al proceso del stack mientras esperamos el callback
        MX_SubGHz_Phy_Process();
    }

    if (radio_tx_done == 0) {
        UART_Print("LoRa: TX timeout!\r\n");
    } else {
        UART_Print("LoRa: TX OK\r\n");
    }
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        rx_buffer[rx_head] = rx_data;
        rx_head = (rx_head + 1) % RX_BUF_SIZE;
        HAL_UART_Receive_IT(&huart1, &rx_data, 1);
    }
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        __HAL_UART_CLEAR_OREFLAG(huart);
        HAL_UART_Receive_IT(&huart1, &rx_data, 1);
    }
}

