/**

 * @brief The application entry point.

 * @retval int

 */

int main(void)

{

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* MCU Configuration--------------------------------------------------------*/

	/* Reset of all peripherals, Initializes the Flash interface and the Systick. */

	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* Configure the system clock */

	SystemClock_Config();

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */

	MX_GPIO_Init();

	MX_USART1_UART_Init();

	MX_USART2_UART_Init();

	/* USER CODE BEGIN 2 */
	// ... (tu código del menú y HAL_UART_Receive_IT) ...
	GPS my_gps;
	memset(&my_gps, 0, sizeof(GPS));

	char nmea_line[120];  // Búfer para armar la oración NMEA

	/* USER CODE END 2 */

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
		while (1) {
			if (rx_head != rx_tail) {
				// Sacamos un byte del búfer circular
				uint8_t byte_to_send = rx_buffer[rx_tail];
				rx_tail = (rx_tail + 1) % RX_BUF_SIZE;

				// 1. Si llega el carácter de salto de línea (\n), la oración terminó
				if (byte_to_send == '\n') {
					// Colocamos el terminador nulo justo donde está el índice actual
					// Esto elimina el '\n' y machaca el '\r' si estuviera inmediatamente antes
					if (nmea_idx > 0 && nmea_line[nmea_idx - 1] == '\r') {
						nmea_line[nmea_idx - 1] = '\0'; // Elimina el retorno de carro
					} else {
						nmea_line[nmea_idx] = '\0';     // Asegura el fin de string
					}

					// 2. Solo llamamos al parser si realmente acumulamos algo de texto
					if (nmea_idx > 0) {
						// Le pasamos la línea limpia a tu librería
						nmea_parse(&gps_data, (uint8_t *)nmea_line);

						// Formateamos los datos utilizando las variables exactas de tu .h
						char msg[150];
						sprintf(msg, "\r\n[GPS] Fix: %d | Satelites: %d | Lat: %.6f %c | Lon: %.6f %c | Altura: %.1fm\r\n",
								gps_data.fix,
								gps_data.satelliteCount,
								gps_data.latitude,
								gps_data.latSide,
								gps_data.longitude,
								gps_data.lonSide,
								gps_data.altitude);

						// Transmitimos el resultado formateado a la PC
						HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), 100);
					}

					// 3. Reiniciamos el índice inmediatamente para la próxima línea
					nmea_idx = 0;
				}
				// 4. Si no es un salto de línea, seguimos acumulando caracteres
				else {
					if (nmea_idx < sizeof(nmea_line) - 1) {
						nmea_line[nmea_idx] = byte_to_send;
						nmea_idx++;
					} else {
						// Protección: Si la línea es sospechosamente larga y satura el búfer, reiniciamos
						nmea_idx = 0;
					}
				}
			}
		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */

	}

	/* USER CODE END 3 */

}

