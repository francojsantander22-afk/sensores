/* USER CODE BEGIN 4 */

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)

{

// === SI EL DATO VIENE DEL GPS ===

	if (huart->Instance == USART1)

	{

// Guardar el byte entrante en la cabeza del búfer

		rx_buffer[rx_head] = rx_data;

		rx_head = (rx_head + 1) % RX_BUF_SIZE;

// Volver a escuchar GPS inmediatamente

		HAL_UART_Receive_IT(&huart1, &rx_data, 1);

	}

// === SI EL DATO VIENE DE LA PC (Teclado en PuTTY) ===

	else if (huart->Instance == USART2)

	{

		uint32_t new_baud = 0;

		if (rx_pc == '1')
			new_baud = 9600;

		else if (rx_pc == '2')
			new_baud = 38400;

		else if (rx_pc == '3')
			new_baud = 57600;

		else if (rx_pc == '4')
			new_baud = 115200;

// Si presionaste una tecla válida, reconfiguramos el USART1

		if (new_baud != 0)

		{

			HAL_UART_DeInit(&huart1); // <--- IMPORTANTE: Apagar antes de reconfigurar

			huart1.Init.BaudRate = new_baud;

			if (HAL_UART_Init(&huart1) == HAL_OK) // Esto re-inicializa el hardware

					{

				char msg[50];

				sprintf(msg, "\r\n[+] GPS cambiado a %lu baudios\r\n",
						new_baud);

				HAL_UART_Transmit(&huart2, (uint8_t*) msg, strlen(msg), 100);

// Reiniciar la escucha del GPS tras el cambio

				HAL_UART_Receive_IT(&huart1, &rx_data, 1);

			}

		}

// Volver a escuchar tu teclado

		HAL_UART_Receive_IT(&huart2, &rx_pc, 1);

	}

}

// === ESCUDO CONTRA EL OVERRUN ERROR ===

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)

{

	if (huart->Instance == USART1)

	{

// Limpiar la bandera de Overrun Error para destrabar el periférico

		__HAL_UART_CLEAR_OREFLAG(huart);

// Volver a armar la interrupción para revivir la escucha

		HAL_UART_Receive_IT(&huart1, &rx_data, 1);

	}

}

