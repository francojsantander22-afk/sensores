/*
 * Recorre el buffer TLV y llena un TelemetryFrame_t.
 * Retorna 1 si decodificó al menos un TAG válido, 0 si el buffer está vacío o corrupto.
 */
static uint8_t tlv_decode(const uint8_t *buf, uint16_t len, TelemetryFrame_t *out)
{
    memset(out, 0, sizeof(TelemetryFrame_t));
    uint16_t i = 0;

    while (i + 2 <= len)   /* mínimo: 1 byte TAG + 1 byte LENGTH */
    {
        uint8_t tag    = buf[i];
        uint8_t length = buf[i + 1];
        i += 2;

        if (i + length > len) break;   /* guard: no leer fuera del buffer */

        switch (tag)
        {
            case TLV_TAG_TIME:
                if (length == 3) {
                    out->hour   = buf[i];
                    out->minute = buf[i+1];
                    out->second = buf[i+2];
                    out->has_gps = 1;
                }
                break;

            case TLV_TAG_GPS_COORD:
                if (length == 8) {
                    out->lat = (int32_t)((buf[i]   << 24) | (buf[i+1] << 16) |
                                         (buf[i+2] <<  8) |  buf[i+3]);
                    out->lon = (int32_t)((buf[i+4] << 24) | (buf[i+5] << 16) |
                                         (buf[i+6] <<  8) |  buf[i+7]);
                }
                break;

            case TLV_TAG_ALTITUDE:
                if (length == 2) {
                    out->altitude = (int16_t)((buf[i] << 8) | buf[i+1]);
                }
                break;

            case TLV_TAG_ACCEL:
                if (length == 6) {
                    out->acc_x = (int16_t)((buf[i]   << 8) | buf[i+1]);
                    out->acc_y = (int16_t)((buf[i+2] << 8) | buf[i+3]);
                    out->acc_z = (int16_t)((buf[i+4] << 8) | buf[i+5]);
                    out->has_imu = 1;
                }
                break;

            case TLV_TAG_GYRO:
                if (length == 6) {
                    out->gyr_x = (int16_t)((buf[i]   << 8) | buf[i+1]);
                    out->gyr_y = (int16_t)((buf[i+2] << 8) | buf[i+3]);
                    out->gyr_z = (int16_t)((buf[i+4] << 8) | buf[i+5]);
                }
                break;

            case TLV_TAG_TEMP:
                if (length == 2) {
                    int16_t raw = (int16_t)((buf[i] << 8) | buf[i+1]);
                    out->temperature = raw / 100.0f;
                }
                break;

            default:
                /* TAG desconocido — saltar su payload y continuar */
                break;
        }
        i += length;
    }

    return (out->has_gps || out->has_imu) ? 1 : 0;
}

/*
 * Imprime por UART2 la trama decodificada en formato ASCII legible.
 */
static void telemetry_print(const TelemetryFrame_t *f, int8_t rssi)
{
    char buf[256];
    int  pos = 0;

    pos += snprintf(buf + pos, sizeof(buf) - pos,
                    "\r\n===== TELEMETRIA HAPS =====\r\n");
    pos += snprintf(buf + pos, sizeof(buf) - pos,
                    "RSSI: %d dBm\r\n", rssi);

    if (f->has_gps) {
        /* Convertir lat/lon de int32 (×100000) a grados decimales */
        float lat_f = f->lat / 100000.0f;
        float lon_f = f->lon / 100000.0f;
        pos += snprintf(buf + pos, sizeof(buf) - pos,
                        "GPS  | Hora(ART): %02d:%02d:%02d\r\n",
                        f->hour, f->minute, f->second);
        pos += snprintf(buf + pos, sizeof(buf) - pos,
                        "GPS  | Lat: %.5f  Lon: %.5f\r\n", lat_f, lon_f);
        pos += snprintf(buf + pos, sizeof(buf) - pos,
                        "GPS  | Altitud: %d m\r\n", f->altitude);
    } else {
        pos += snprintf(buf + pos, sizeof(buf) - pos,
                        "GPS  | Sin fix\r\n");
    }

    if (f->has_imu) {
        pos += snprintf(buf + pos, sizeof(buf) - pos,
                        "ACCEL| X:%6d  Y:%6d  Z:%6d (LSB)\r\n",
                        f->acc_x, f->acc_y, f->acc_z);
        pos += snprintf(buf + pos, sizeof(buf) - pos,
                        "GYRO | X:%6d  Y:%6d  Z:%6d (LSB)\r\n",
                        f->gyr_x, f->gyr_y, f->gyr_z);
        pos += snprintf(buf + pos, sizeof(buf) - pos,
                        "TEMP | %.2f C\r\n", f->temperature);
    }

    pos += snprintf(buf + pos, sizeof(buf) - pos,
                    "===========================\r\n");

    HAL_UART_Transmit(&huart2, (uint8_t*)buf, pos, HAL_MAX_DELAY);
}

