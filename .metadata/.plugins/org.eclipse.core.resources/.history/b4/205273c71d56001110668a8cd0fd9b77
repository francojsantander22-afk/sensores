/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SubGHz_Phy_Init();
  /* USER CODE BEGIN 2 */
  extern int8_t RssiValue;
  //HAL_GPIO_WritePin(GPIOA, LED_GREEN, GPIO_PIN_SET);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      if (tlv_rx_ready)
      {
          tlv_rx_ready = 0;   /* consumir el flag primero */
          HAL_UART_Transmit(&huart2, (uint8_t*)"ENTRO A MAIN\r\n", 29, HAL_MAX_DELAY);
          TelemetryFrame_t frame = {0};
          uint8_t ok = tlv_decode(BufferRx, RxBufferSize, &frame);

          if (ok) {
              telemetry_print(&frame, RssiValue);
          } else {
              HAL_UART_Transmit(&huart2,
                  (uint8_t*)"[WARN] Paquete TLV invalido\r\n", 29,
                  HAL_MAX_DELAY);
          }
      }
      /* USER CODE END WHILE */
      MX_SubGHz_Phy_Process();
  }
      /* USER CODE BEGIN 3 */
  }
