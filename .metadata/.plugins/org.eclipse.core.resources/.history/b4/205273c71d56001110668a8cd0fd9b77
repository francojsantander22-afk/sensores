/* Tags TLV — deben coincidir exactamente con el transmisor */
#define TLV_TAG_TIME       0x01
#define TLV_TAG_GPS_COORD  0x02
#define TLV_TAG_ALTITUDE   0x03
#define TLV_TAG_ACCEL      0x04
#define TLV_TAG_TEMP       0x05
#define TLV_TAG_GYRO       0x06

/* Resultado del parseo TLV */
typedef struct {
    uint8_t  has_gps;
    uint8_t  hour, minute, second;
    int32_t  lat;        /* grados × 100000 */
    int32_t  lon;
    int16_t  altitude;
    uint8_t  has_imu;
    int16_t  acc_x, acc_y, acc_z;
    int16_t  gyr_x, gyr_y, gyr_z;
    float    temperature;
} TelemetryFrame_t;

