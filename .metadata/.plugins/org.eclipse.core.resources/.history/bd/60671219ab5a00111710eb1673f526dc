					// 2. Verificamos si hay conexión y tenemos fix satelital
					else if (gps_valid && fix_str[0] >= '1') {
						snprintf(ascii_msg, sizeof(ascii_msg),
								"\r\n[GPS] Lat: %s %s, Lon: %s %s, Alt: %s, Vel: %.2f km/h\r\n"
